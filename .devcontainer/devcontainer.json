{
  "name": "PolisAI Classroom",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "forwardPorts": [5173, 3210],
  "portsAttributes": {
    "5173": {
      "label": "PolisAI Frontend",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "3210": {
      "label": "Convex Backend (local)",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash scripts/codespaces-setup.sh",
  "postStartCommand": "bash scripts/codespaces-start.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["agents/README.md"]
    }
  }
}
